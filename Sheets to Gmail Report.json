      "id": "code-build-email-1",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nif (!rows.length) {\n  return [];\n}\n\nconst rowLines = rows.map((row, idx) => {\n  const fields = Object.entries(row)\n    .map(([key, value]) => `- ${key}: ${value}`)\n    .join('\\n');\n  return `Row ${idx + 1}:\\n${fields}`;\n}).join('\\n\\n');\n\nconst subject = `Data Summary from Google Sheet (${rows.length} row${rows.length > 1 ? 's' : ''})`;\nconst body = `Hi,\\n\\nHere is the latest data from the sheet:\\n\\n${rowLines}\\n\\nRegards,\\nYour Automation Bot`;\n\nreturn [{ json: { subject, body } }];"
      }
    },
